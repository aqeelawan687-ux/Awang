# Treat all files as text with LF line endings by default
* text=auto eol=lf

# Explicitly mark Gradle wrapper scripts
/gradlew text eol=lf
/gradlew.bat text eol=crlf

# Explicitly mark binary files so they are never corrupted during Git transfers or checkout
*.jar binary
*.class binary
*.apk binary
*.aab binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.so binary
*.jks binary
*.keystore binary
